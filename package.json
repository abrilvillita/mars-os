{
  "name": "mars-os",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "schema": "tsx scripts/generate-schema.ts",
    "validate": "tsx scripts/validate-data.ts",
    "data:mola": "node scripts/fetch-mola.mjs",
    "data:fallback": "node scripts/fetch-fallback-tiles.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "dev:web": "vite",
    "server": "tsx server/index.ts",
    "start": "vite build && tsx server/index.ts --serve-dist",
    "data:ctx": "node scripts/build-ctx-pyramid.mjs",
    "data:cachecam": "node scripts/build-cachecam-index.mjs",
    "data:samples": "node scripts/build-samples.mjs",
    "data:expeditions": "node scripts/build-expeditions.mjs",
    "data:media": "node scripts/build-media.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "i18next": "^27.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
